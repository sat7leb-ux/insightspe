# Supabase (get these from Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://nexbyquzytajhmklapjs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: service role key for admin operations (NEVER expose to the browser)
# Used only server-side. With the admin-users edge function deployed, this is not required.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=https://insightspe.vercel.app

# Optional: YouTube Data API key for automatic post metrics (server-side only).
# Google Cloud Console → Create project → Enable "YouTube Data API v3" → Credentials → API key.
# With this key set, pasting a YouTube URL in the post form auto-fills title,
# date, views, likes and comments; existing posts show a "Sync" button.
YOUTUBE_API_KEY=
